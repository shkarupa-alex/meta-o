# skills/ is deliberately NOT ignored: apm and `npx skills` install the skills from
# what this repository has committed, so the built tree has to be present in it.
# `make mo-qc` proves skills/ byte-matches a fresh build of src/skills/ + shared/,
# which is what keeps a committed build artefact honest.
node_modules
.DS_Store

# Build output of the retired TypeScript implementation and Python bytecode from
# the templates on other branches. A candidate checkout must stay clean, because
# §2.8 of the review contract turns a dirty worktree into `unknown`.
dist/
__pycache__/
*.pyc

# Meta-O runtime and private specification workspaces must never become tracked
# inputs; canonical implementation specs use the project-owned docs/ path.
.orca/
spec/
