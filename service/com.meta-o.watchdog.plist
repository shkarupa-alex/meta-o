<?xml version="1.0" encoding="UTF-8"?>
<!--
  §M-WATCHDOG-SERVICE — launchd user agent for the deterministic watchdog.

  §50 runs the watchdog as a user agent, never a system daemon: it reads
  ~/.meta-o, which is 0700 and belongs to one person.

  The installer substitutes the real binary path for __WATCHDOG_BIN__ and the
  real home for __HOME__, so the copy under share/meta-o/service/ is ready to
  load as it stands.

  Install:
    mkdir -p ~/Library/LaunchAgents
    cp ~/.local/share/meta-o/service/com.meta-o.watchdog.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.meta-o.watchdog.plist

  It observes nothing until `meta-o watchdog enable` names a project.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meta-o.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WATCHDOG_BIN__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardErrorPath</key>
  <string>__HOME__/.meta-o/watchdog.stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
