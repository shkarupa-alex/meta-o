// Markdown lint for a project whose product is Markdown.
//
// Rules are relaxed only where the default fights the content rather than the
// quality: ordinary lines allow 100 columns, while tables and code blocks are
// excluded because their structure determines width. Duplicate headings are
// allowed across sections because a reference document legitimately repeats
// "Evidence" or "Why".
{
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "skills/**",
    "spec/**",
    ".orca/**",
    "docs/references/**",
    "docs/research/**",
    "shared/licenses/**",
  ],
  "config": {
    "default": true,
    "MD013": { "line_length": 100, "code_blocks": false, "tables": false },
    // Makefile snippets are tab-indented by language, not by preference.
    "MD010": { "code_blocks": false },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
  },
}
