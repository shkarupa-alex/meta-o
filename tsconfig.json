{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    // A leftover import is invisible to every other gate here: `lint.mjs` has no
    // unused-symbol rule, and splitting a large module leaves a dozen of them.
    // Parameters are deliberately not included: a signature that conforms to an
    // interface may legitimately ignore an argument.
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,

    "declaration": true,
    "sourceMap": false,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src/**/*.mts"]
}
