[
  {
    "id": "local-git",
    "ecosystems": ["any"],
    "capabilities": ["semantic_search", "maintenance"],
    "required_tools": ["git", "rg"],
    "version_probe": ["git", "--version"],
    "capability_probe": ["rg", "--help"],
    "install_help": {
      "macos": "xcode-select --install && brew install ripgrep",
      "debian": "sudo apt-get install git ripgrep",
      "windows": "winget install Git.Git BurntSushi.ripgrep.MSVC",
      "other": "Install Git and ripgrep from their official distributions"
    },
    "base_url": "local://repository",
    "auth_required": "never",
    "operations": [
      {
        "capability": "semantic_search",
        "transport": "argv",
        "argv_or_url": ["rg", "-n", "-i", "{query}", "."],
        "output": "text",
        "success": { "exit_codes": [0, 1] },
        "errors": {
          "ENOENT": "tool_missing",
          "2": "source_unavailable",
          "unsupported": "adapter_unsupported",
          "parse": "malformed"
        }
      },
      {
        "capability": "maintenance",
        "transport": "argv",
        "argv_or_url": ["git", "log", "-S", "{query}", "--oneline", "--all"],
        "output": "text",
        "success": { "exit_codes": [0] },
        "errors": {
          "ENOENT": "tool_missing",
          "128": "source_unavailable",
          "unsupported": "adapter_unsupported",
          "parse": "malformed"
        }
      }
    ],
    "unavailable_fields": ["downloads", "reverse_dependencies"],
    "last_verified": "2026-09-02"
  },
