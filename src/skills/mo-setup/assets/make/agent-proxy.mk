# >>> meta-o: прокси сред агентов >>>
# Управляемый блок mo-setup. Замените <agent-env-targets> на цели, которые
# запускают сами среды агентов (Claude, Codex, OpenCode): живые адаптеры, eval
# с моделью. Пустой список допустим.
#
# Прокси владельца нужен только самим средам агентов для API поставщиков.
# Командам, которые агенты запускают, он не нужен и чаще мешает: QC и тесты
# ходят на localhost и во внутренние ресурсы. Поэтому все рецепты, включая
# вложенный $(MAKE), получают окружение без прокси.
MO_PROXY_VARS := HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
unexport $(MO_PROXY_VARS)

# Целевые переменные наследуют предпосылки цели, поэтому у этих целей нет
# предпосылок QC и тестов: иначе QC снова пошёл бы через прокси.
MO_AGENT_ENV_TARGETS := <agent-env-targets>

# Каждая цель из списка получает обратно только заданные переменные. Целевой
# `export VAR := $(VAR)` от незаданной экспортировал бы пустую строку, а пустая
# переменная в нижнем регистре у Python и Node отменяет заданную в верхнем:
# цель среды агента осталась бы без прокси.
# Значение берётся через `$(value VAR)`: оно не попадает в текст рецепта, make
# его не печатает, а `$` и `#` внутри него не раскрываются.
$(if $(strip $(MO_AGENT_ENV_TARGETS)),$(foreach var,$(MO_PROXY_VARS),$(if $(value $(var)),$(eval $(MO_AGENT_ENV_TARGETS): export $(var) := $$(value $(var))))))
# <<< meta-o: прокси сред агентов <<<
