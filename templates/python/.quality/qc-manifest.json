{
  "schema_version": 1,
  "gates": [
    {
      "id": "format-check",
      "command": "ruff format --check .",
      "policy": "passed"
    },
    {
      "id": "lint",
      "command": "ruff check .",
      "policy": "passed"
    },
    {
      "id": "typecheck-policy",
      "command": "mypy .",
      "policy": "passed"
    },
    {
      "id": "tests",
      "command": "pytest -q",
      "policy": "passed"
    },
    {
      "id": "build-policy",
      "command": "python3 -m build",
      "policy": "not_applicable",
      "rationale": "this project ships no distributable artifact; revisit when it publishes a package"
    },
    {
      "id": "purpose",
      "command": "python3 quality/purpose_check.py",
      "policy": "passed"
    },
    {
      "id": "knowledge",
      "command": "python3 quality/knowledge_check.py",
      "policy": "passed"
    },
    {
      "id": "import-graph",
      "command": "python3 quality/import_graph.py",
      "policy": "passed"
    },
    {
      "id": "code-health",
      "command": "python3 quality/code_health.py",
      "policy": "passed"
    },
    {
      "id": "e2e-metadata",
      "command": "python3 quality/e2e_check.py",
      "policy": "passed"
    }
  ]
}
